#!/bin/bash
set -euo pipefail

lib_dir="$HOME/.local/lib/tacc-vista"
# shellcheck source=/dev/null
source "$lib_dir/common.sh"
load_config
require_config_vars LOGIN_ALIAS COMPUTE_ALIAS REMOTE_PROJECT_DIR PARTITIONS PARTITION_LIMITS PARTITION_NODE_LIMITS DEFAULT_PARTITION DEFAULT_HOURS PREFERRED_IDE

partition="${1:-$DEFAULT_PARTITION}"
time_input="${2:-$DEFAULT_HOURS}"
third_arg="${3:-}"
fourth_arg="${4:-}"
nodes=1
editor="$PREFERRED_IDE"

if [[ "$third_arg" =~ ^[0-9]+$ ]]; then
    nodes=$((10#$third_arg))
    editor="${fourth_arg:-$PREFERRED_IDE}"
    if (( $# > 4 )); then
        printf '%s\n' 'Too many arguments. Expected partition, time, nodes, and optional editor.' >&2
        exit 2
    fi
else
    editor="${third_arg:-$PREFERRED_IDE}"
    if [[ -n "$fourth_arg" || $# -gt 3 ]]; then
        printf '%s\n' 'Node count must be a positive integer before the editor argument.' >&2
        exit 2
    fi
fi

if [[ ! "$partition" =~ ^[A-Za-z0-9._-]+$ ]] || ! csv_contains "$PARTITIONS" "$partition"; then
    printf 'Partition is not allowed by the external configuration: %s\n' "$partition" >&2
    exit 2
fi
walltime="$(normalize_walltime "$time_input")"
limit_hours="$(partition_limit_hours "$PARTITION_LIMITS" "$partition")" || {
    printf 'No configured time limit for partition: %s\n' "$partition" >&2
    exit 2
}
if (( $(walltime_seconds "$walltime") > 10#$limit_hours * 3600 )); then
    printf 'Requested time exceeds the configured limit for partition %s.\n' "$partition" >&2
    exit 2
fi
limit_nodes="$(partition_limit_nodes "$PARTITION_NODE_LIMITS" "$partition")" || {
    printf 'No configured node limit for partition: %s\n' "$partition" >&2
    exit 2
}
if (( nodes < 1 || nodes > 10#$limit_nodes )); then
    printf 'Node count for partition %s must be between 1 and %s.\n' "$partition" "$limit_nodes" >&2
    exit 2
fi
case "$editor" in cursor|code|none) ;; *) printf '%s\n' 'Editor must be cursor, code, or none.' >&2; exit 2 ;; esac

remote_command="\$HOME/.local/lib/tacc-vista/submit-node.sh '$partition' '$walltime' '$nodes'"
if ! job_output="$(ssh -T "$LOGIN_ALIAS" "$remote_command")"; then
    exit 1
fi
job_id="$(awk '/^[0-9]+$/ { print; exit }' <<<"$job_output")"
if [[ -z "$job_id" ]]; then
    printf '%s\n' 'The allocation job ID could not be read.' >&2
    exit 1
fi

printf 'Waiting for the %s-node allocation to receive compute nodes...\n' "$nodes"
"$HOME/.local/bin/vista-node-update.sh" "$job_id"

if [[ "$editor" == none ]]; then
    printf '%s\n' 'The compute SSH alias is ready.'
    exit 0
fi

if [[ "${TACC_VISTA_DASHBOARD_AUTO_OPEN:-1}" != 0 ]]; then
    if ! "$HOME/.local/bin/vista-dashboard-open"; then
        printf '%s\n' 'Warning: the dashboard could not be opened; continuing with the IDE.' >&2
    fi
fi

if [[ "$editor" == cursor ]]; then
    editor_cli="$(command -v cursor || true)"
    if [[ -z "$editor_cli" && -x '/Applications/Cursor.app/Contents/Resources/app/bin/cursor' ]]; then
        editor_cli='/Applications/Cursor.app/Contents/Resources/app/bin/cursor'
    fi
    editor_name='Cursor'
else
    editor_cli="$(command -v code || true)"
    if [[ -z "$editor_cli" && -x '/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code' ]]; then
        editor_cli='/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code'
    fi
    editor_name='VS Code'
fi
if [[ -z "$editor_cli" ]]; then
    printf '%s command was not found; the compute alias is ready for manual connection.\n' "$editor_name" >&2
    exit 1
fi

remote_path="$REMOTE_PROJECT_DIR"
if command -v python3 >/dev/null 2>&1; then
    remote_path="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe="/"))' "$REMOTE_PROJECT_DIR")"
fi
allocation_alias="${COMPUTE_ALIAS}-${job_id}"
remote_uri="vscode-remote://ssh-remote+${allocation_alias}${remote_path}"
printf 'Opening one %s window for the requested allocation...\n' "$editor_name"
if [[ "$editor" == cursor ]]; then
    # Cursor 3.x may otherwise route a remote-folder launch into its
    # Agent/Glass landing window instead of a conventional IDE window.
    exec "$editor_cli" --classic --new-window --folder-uri "$remote_uri"
fi
exec "$editor_cli" --new-window --folder-uri "$remote_uri"
